# Example environment variables for FocusLife
# Copy this file to .env (or set secrets in your CI/CD) and fill values.

# Application URLs
APP_BACKEND_URL=https://api.focus.lzguimaraes.com.br
APP_FRONTEND_URL=https://focus.lzguimaraes.com.br

# Ports (only used for local development)
FRONTEND_PORT=3000
BACKEND_PORT=8080

# CORS
CORS_ALLOWED_ORIGINS=https://focus.lzguimaraes.com.br

# JWT
JWT_SECRET=<YOUR_STRONG_JWT_SECRET>

# Spring datasource (production should point to your managed Postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://<DB_HOST>:5432/<DB_NAME>
SPRING_DATASOURCE_USERNAME=<DB_USER>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# SMTP (mail sending)
SPRING_MAIL_USERNAME=<SMTP_USER_OR_EMAIL>
SPRING_MAIL_PASSWORD=<SMTP_PASSWORD>
SPRING_MAIL_FROM=<noreply@yourdomain.com>

# VPS / Deployment (optional)
SSH_PASSPHRASE=
VPS_HOST=
VPS_SSH_KEY=
VPS_USER=

# NOTES:
# - Do NOT commit your real .env to the repository. Use CI/CD secrets or a secret manager.
# - For local dev with docker-compose, you can use the Postgres service name `db` as DB host:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/focuslife
